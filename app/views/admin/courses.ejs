<%- include('../partials/header') %>
<div class="row between"><h1>Quản lý khóa học</h1><a class="btn" href="/admin/courses/new">+ Thêm khóa học</a></div>
<%- include('../partials/admin-nav', { active: 'courses' }) %>
<table class="table card">
  <thead><tr><th>#</th><th>Tên khóa học</th><th>Giảng viên</th><th>Cấp độ</th><th>Bài</th><th>Học viên</th><th>Trạng thái</th><th></th></tr></thead>
  <tbody>
  <% courses.forEach(function (c) { %>
    <tr>
      <td><%= c.id %></td>
      <td><a href="/courses/<%= c.id %>"><%= c.title %></a></td>
      <td><%= c.instructor %></td>
      <td><%= c.level %></td>
      <td><%= c.lesson_count %></td>
      <td><%= c.student_count %></td>
      <td><%= c.is_published ? 'Xuất bản' : 'Nháp' %></td>
      <td class="actions">
        <a href="/admin/courses/<%= c.id %>/lessons">Bài học</a>
        <a href="/admin/courses/<%= c.id %>/edit">Sửa</a>
        <form method="post" action="/admin/courses/<%= c.id %>/delete" class="inline" data-confirm="Xóa khóa học này cùng toàn bộ bài học?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-btn danger" type="submit">Xóa</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<script src="/js/app.js"></script>
<%- include('../partials/footer') %>
