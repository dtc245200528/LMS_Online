<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · EduLite LMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="brand-mark">E</span>EduLite<span class="brand-sub">LMS</span></a>
    <nav class="nav">
      <a href="/">Khóa học</a>
      <% if (currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin">Quản trị</a>
        <% } else { %>
          <a href="/my-courses">Khóa học của tôi</a>
        <% } %>
        <span class="who"><%= currentUser.name %></span>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-btn" type="submit">Đăng xuất</button>
        </form>
      <% } else { %>
        <a href="/login">Đăng nhập</a>
        <a class="btn btn-sm" href="/register">Đăng ký</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap main">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
<% } %>
